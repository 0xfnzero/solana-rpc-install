[Unit]
Description=Solana Validator
After=network.target network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
Restart=always
RestartSec=30
User=root
LimitNOFILE=1000000
LimitNPROC=1000000
LimitMEMLOCK=2000000000
LimitCORE=infinity
LogRateLimitIntervalSec=0
Environment="PATH=/usr/local/solana/bin:/usr/bin:/bin"
Environment="RUST_LOG=info"
Environment="RUST_BACKTRACE=1"
# Keep the validator preferred without starving the rest of the system
OOMScoreAdjust=-500
# Latency-sensitive replay must not be throttled by memory.high. Keep only a
# hard last-resort boundary so the operating system retains recovery headroom.
MemoryHigh=infinity
MemoryMax=90%
# CPU affinity and scheduling
Nice=-10
IOSchedulingClass=best-effort
IOSchedulingPriority=0
# Watchdog disabled - node initialization takes longer than 2 minutes
# WatchdogSec=120
# Graceful shutdown timeout
TimeoutStopSec=300
KillMode=mixed
KillSignal=SIGINT
# Working directory
WorkingDirectory=/root/sol
# Startup command (auto-selects appropriate validator script based on RAM)
ExecStart=/bin/bash -c '/root/sol/bin/select-validator.sh'
# Pre-start validation
ExecStartPre=/bin/bash -c 'test -f /root/sol/bin/validator-keypair.json'
ExecStartPre=/bin/bash -c 'test -d /root/sol/ledger'
ExecStartPre=/bin/bash -c 'test -d /root/sol/accounts'

[Install]
WantedBy=multi-user.target
